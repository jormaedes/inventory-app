<div class="bg-white rounded-lg shadow p-4 flex flex-col gap-3">
	<div class="flex items-center gap-3">
		<i class="ri-instance-fill text-3xl text-indigo-500"></i>
		<h4 class="font-semibold text-lg text-gray-900"><%= category.name %></h4>
	</div>
	<p class="text-sm text-gray-600"><%= category.description %></p>
	<div class="flex gap-2 mt-2">
		<a class="flex-1 text-center py-2 border border-indigo-600 text-indigo-600 rounded-md hover:bg-indigo-50 transition" href="/categories/<%= category.id %>/edit">Edit</a>
		<a class="flex-1 text-center py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition" href="/categories/<%= category.id %>/delete">Delete</a>
	</div>
</div>