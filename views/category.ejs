	<div class="category-card">
	<div class="category-card-body">
		<div class="category-card-head">
			<span class="category-index"><%= String(category.id).padStart(2, '0') %></span>
			<span class="card-category">Department</span>
		</div>
		<h2 class="card-title"><%= category.name %></h2>
		<p class="category-description"><%= category.description %></p>
		<div class="card-actions">
			<a class="card-action" href="/categories/<%= category.id %>/edit">Edit details</a>
			<a class="card-action card-action--danger" href="/categories/<%= category.id %>/delete">Delete</a>
		</div>
	</div>
</div>