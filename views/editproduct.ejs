<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>Edit Product</title>
</head>
<body class="app-body flex flex-col">
	<%- include('header') %>
	<main class="flex-auto">
		<div class="form-wrap">
			<div class="form-heading"><p class="page-kicker">Catalogue / Edit record</p><h1 class="form-title">Edit product</h1></div>
			<div class="form-panel">
				<form class="form-grid" action="/products/<%= product.id %>/edit" method="POST">
					<div class="form-field form-field--wide">
						<label class="form-label" for="name">Product name</label>
						<input required id="name" name="name" value="<%= product.name %>" type="text" class="form-control" />
					</div>
					<div class="form-field">
						<label class="form-label" for="price">Unit price</label>
						<input required id="price" name="price" value="<%= product.price %>" type="number" min="0" step="0.01" class="form-control" />
					</div>
					<div class="form-field">
						<label class="form-label" for="stock">Stock quantity</label>
						<input required id="stock" name="stock" value="<%= product.qtd_stock %>" type="number" min="0" class="form-control" />
					</div>
					<div class="form-field form-field--wide">
						<label class="form-label" for="category">Category</label>
						<select id="category" name="category" required class="form-control">
							<% categories.forEach(category => { %>
								<option value="<%= category.id %>" <%= category.name === product.category_name ? 'selected' : '' %>><%= category.name %></option>
							<% }) %>
						</select>
					</div>
					<div class="form-actions">
						<a href="/products" class="button-secondary">Cancel</a>
						<button type="submit" class="button-primary">Save changes <span aria-hidden="true">&rarr;</span></button>
					</div>
				</form>
			</div>
		</div>
	</main>
	<%- include('footer') %>
</body>
</html>