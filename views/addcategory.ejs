<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>FakeStore — Add Category</title>
</head>
<body class="app-body flex flex-col">
	<%- include('header') %>

	<main class="page-main">
		<div class="form-wrap">
			<div class="form-heading"><p class="page-kicker">Catalogue / New record</p><h1 class="form-title">Add a category</h1></div>
			<div class="form-panel">
				<form class="form-grid" action="/categories/new" method="post">
					<div class="form-field form-field--wide">
						<label class="form-label" for="name">Category name</label>
						<input required name="name" id="name" type="text" class="form-control" />
					</div>
					<div class="form-field form-field--wide">
						<label class="form-label" for="description">Description</label>
						<textarea name="description" id="description" class="form-control"></textarea>
					</div>
					<div class="form-actions">
						<a href="/categories" class="button-secondary">Cancel</a>
						<button type="submit" class="button-primary">Save category <span aria-hidden="true">&rarr;</span></button>
					</div>
				</form>
			</div>
		</div>
	</main>

	<%- include('footer') %>
</body>
</html>