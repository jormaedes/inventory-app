<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">

	<title>FakeStore</title>
</head>

<body class="flex flex-col h-screen">
	<%- include('header') %>
		<main class="flex-auto flex">
			<div class="container mx-auto py-2.5 flex items-center justify-center bg-gray-400">
				<form class="flex flex-col gap-2" action="/categories/new" method="post">
					<div class="flex flex-col">
						<label for="name">Category name:</label>
						<input class="bg-neutral" type="text" name="name" id="name">
					</div>
					<div class="flex flex-col">
						<label for="description">Description</label>
						<textarea class="bg-neutral" name="description" id="description"></textarea>
					</div>
					<button class="rounded-md bg-secundary" type="submit">Add Category</button>
				</form>
			</div>
		</main>
		<%- include('footer') %>
</body>

</html>