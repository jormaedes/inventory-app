<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>FakeStore</title>
</head>
<body class="app-body flex flex-col">
	<%- include('header') %>

	<main class="page-main">
		<div class="page-container">
			<div class="page-heading">
				<div><p class="page-kicker">Catalogue / 01</p><h1 class="page-title">Products</h1><p class="page-subtitle">Every item, price and stock level in one place.</p></div>
				<a href="/products/new" class="button-primary">Add product <span aria-hidden="true">+</span></a>
			</div>

			<% if (products.length) { %>
			<div class="collection-grid">
				<% products.forEach(prod=> { %>
					<%- include('product', { prod: prod }) %>
				<% }); %>
			</div>
			<% } else { %>
			<div class="empty-state"><p>No products in the catalogue yet.</p><a href="/products/new" class="button-primary">Add your first product <span aria-hidden="true">+</span></a></div>
			<% } %>
		</div>
	</main>

	<%- include('footer') %>
</body>
</html>