<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/output.css">
  <title>Error</title>
</head>
<body class="app-body flex flex-col">
  <%- include('header') %>

  <main class="page-main flex items-center">
    <div class="error-wrap">
      <div class="error-panel">
        <p class="page-kicker">System / Notice</p>
        <h1 class="form-title">An error occurred</h1>
        <% if (typeof status !== 'undefined') { %>
          <p class="page-subtitle">Status: <%= status %></p>
        <% } %>
        <% if (message) { %>
          <p class="home-copy"><%= message %></p>
        <% } %>
        <div class="error-actions">
          <a href="/" class="button-primary">Return home</a>
          <a href="javascript:history.back()" class="button-secondary">Go back</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('footer') %>
</body>
</html>
