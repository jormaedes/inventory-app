<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">

	<title>FakeStore</title>
</head>

<body class="flex flex-col h-screen">
	<%- include('header') %>
		<main class="flex-auto flex">
			<div class="container mx-auto py-2.5 flex items-center justify-center bg-gray-400">
				<form class="flex flex-col gap-2" action="/products/new" method="post">
					<div class="flex flex-col">
						<label for="name">Product name:</label>
						<input class="bg-neutral" type="text" name="name" id="name">
					</div>
					<div class="flex flex-col">
						<label for="price">Product price:</label>
						<input class="bg-neutral" type="text" name="price" id="price">
					</div>
					<div class="flex flex-col">
						<label for="price">Quantity Stock:</label>
						<input class="bg-neutral" type="number" name="stock" id="stock">
					</div>
					<div class="flex">
						<label for="caterory">select category:</label>
						<select name="category" id="category">
							<% categories.forEach(category => { %>
								<option value="<%= category.id %>"><%= category.name %></option>
							<% }) %>
						</select>
					</div>
					<button class="bg-neutral" type="submit">Add Product</button>
				</form>
			</div>
		</main>
		<%- include('footer') %>
</body>

</html>