<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>FakeStore — Add Product</title>
</head>
<body class="flex flex-col min-h-screen bg-gray-50">
	<%- include('header') %>

	<main class="flex-auto">
		<div class="max-w-2xl mx-auto px-4 py-10">
			<div class="bg-white p-6 rounded-lg shadow">
				<h2 class="text-xl font-semibold mb-4">Add Product</h2>
				<form class="grid grid-cols-1 gap-4" action="/products/new" method="post">
					<div>
						<label class="block text-sm font-medium text-gray-700">Product name</label>
						<input required name="name" id="name" type="text" class="mt-1 block w-full border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700">Price</label>
						<input required name="price" id="price" type="number" step="0.01" class="mt-1 block w-full border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700">Stock Quantity</label>
						<input required name="stock" id="stock" type="number" class="mt-1 block w-full border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700">Category</label>
						<select name="category" id="category" class="mt-1 block w-full border rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
							<% categories.forEach(category => { %>
								<option value="<%= category.id %>"><%= category.name %></option>
							<% }) %>
						</select>
					</div>
					<div class="flex gap-2 justify-end">
						<a href="/products" class="px-4 py-2 rounded-md border text-indigo-600 hover:bg-indigo-50">Cancel</a>
						<button type="submit" class="px-4 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700">Add Product</button>
					</div>
				</form>
			</div>
		</div>
	</main>

	<%- include('footer') %>
</body>
</html>