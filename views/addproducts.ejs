<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>FakeStore — Add Product</title>
</head>
<body class="app-body flex flex-col">
	<%- include('header') %>

	<main class="page-main">
		<div class="form-wrap">
			<div class="form-heading"><p class="page-kicker">Catalogue / New record</p><h1 class="form-title">Add a product</h1></div>
			<div class="form-panel">
				<form class="form-grid" action="/products/new" method="post">
					<div class="form-field form-field--wide">
						<label class="form-label" for="name">Product name</label>
						<input required name="name" id="name" type="text" class="form-control" />
					</div>
					<div class="form-field">
						<label class="form-label" for="price">Unit price</label>
						<input required name="price" id="price" type="number" step="0.01" min="0" class="form-control" />
					</div>
					<div class="form-field">
						<label class="form-label" for="stock">Stock quantity</label>
						<input required name="stock" id="stock" type="number" min="0" class="form-control" />
					</div>
					<div class="form-field form-field--wide">
						<label class="form-label" for="category">Category</label>
						<select name="category" id="category" class="form-control">
							<% categories.forEach(category => { %>
								<option value="<%= category.id %>"><%= category.name %></option>
							<% }) %>
						</select>
					</div>
					<div class="form-actions">
						<a href="/products" class="button-secondary">Cancel</a>
						<button type="submit" class="button-primary">Save product <span aria-hidden="true">&rarr;</span></button>
					</div>
				</form>
			</div>
		</div>
	</main>

	<%- include('footer') %>
</body>
</html>