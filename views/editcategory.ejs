<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>Edit Category</title>
</head>
<body class="app-body flex flex-col">
	<%- include('header') %>
	<main class="flex-auto">
		<div class="form-wrap">
			<div class="form-heading"><p class="page-kicker">Catalogue / Edit record</p><h1 class="form-title">Edit category</h1></div>
			<div class="form-panel">
				<form class="form-grid" action="/categories/<%= category.id %>/edit" method="POST">
					<div class="form-field form-field--wide">
						<label class="form-label" for="name">Category name</label>
						<input required id="name" name="name" value="<%= category.name %>" type="text" class="form-control" />
					</div>
					<div class="form-field form-field--wide">
						<label class="form-label" for="description">Description</label>
						<textarea id="description" name="description" class="form-control" required><%= category.description %></textarea>
					</div>
					<div class="form-actions">
						<a href="/categories" class="button-secondary">Cancel</a>
						<button type="submit" class="button-primary">Save changes <span aria-hidden="true">&rarr;</span></button>
					</div>
				</form>
			</div>
		</div>
	</main>
	<%- include('footer') %>
</body>
</html>