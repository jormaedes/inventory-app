<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css">

	<title>FakeStore</title>
</head>

<body class="flex flex-col h-screen">
	<%- include('header') %>
		<main class="flex-auto flex">
			<div class="container mx-auto py-2.5">
				<div class="flex items-center justify-between gap-1.5 mb-3">
					<h3 class="font-bold text-2xl">Categories</h3>
					<a class="rounded-md px-2 font-medium py-1 border bg-black text-neutral" href="/categories/new">+
						Add Category</a>
				</div>
				<div class="flex flex-wrap gap-2.5">
					<% categories.forEach(cat=> { %>
						<%- include('category', { category: cat }) %>
							<% }); %>
				</div>
			</div>

		</main>
		<%- include('footer') %>
</body>

</html>