<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>FakeStore</title>
</head>
<body class="app-body flex flex-col">
	<%- include('header') %>

	<main class="page-main">
		<div class="page-container">
			<div class="page-heading">
				<div><p class="page-kicker">Catalogue / 02</p><h1 class="page-title">Categories</h1><p class="page-subtitle">A useful structure for everything you keep.</p></div>
				<a href="/categories/new" class="button-primary">Add category <span aria-hidden="true">+</span></a>
			</div>

			<% if (categories.length) { %>
			<div class="collection-grid">
				<% categories.forEach(cat=> { %>
					<%- include('category', { category: cat }) %>
				<% }); %>
			</div>
			<% } else { %>
			<div class="empty-state"><p>No categories have been created yet.</p><a href="/categories/new" class="button-primary">Create the first category <span aria-hidden="true">+</span></a></div>
			<% } %>
		</div>
	</main>

	<%- include('footer') %>
</body>
</html>