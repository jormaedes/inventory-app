<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>FakeStore</title>
</head>
<body class="flex flex-col min-h-screen bg-gray-50">
	<%- include('header') %>

	<main class="flex-auto">
		<section class="max-w-4xl mx-auto py-20 px-4 text-center">
			<h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900">Welcome to FakeStore</h1>
			<p class="mt-4 text-gray-600 max-w-2xl mx-auto">Pro Inventory is the industry standard system for efficient inventory management. It helps operations managers maintain accuracy and control over products and categories.</p>
			<div class="mt-8 flex justify-center gap-4">
				<a class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-md font-semibold transition" href="/products">View Products</a>
				<a class="inline-block border border-indigo-600 text-indigo-600 hover:bg-indigo-50 px-5 py-3 rounded-md font-semibold transition" href="/categories">View Categories</a>
			</div>
		</section>
	</main>

	<%- include('footer') %>
</body>
</html>