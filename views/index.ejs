<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="/css/output.css">
	<title>FakeStore</title>
</head>
<body class="app-body flex flex-col">
	<%- include('header') %>

	<main class="home-main">
		<section class="home-wrap">
			<div class="home-layout">
				<div>
					<p class="eyebrow">Independent goods / Inventory desk</p>
					<h1 class="home-title">A clear view of what's <em>on your shelves.</em></h1>
					<p class="home-copy">Keep products, categories and stock in one considered place. A small, dependable workspace for the details that keep a store moving.</p>
					<div class="home-actions">
						<a class="button-primary" href="/products">Browse products <span aria-hidden="true">&rarr;</span></a>
						<a class="button-secondary" href="/categories">Explore categories</a>
					</div>
					<p class="home-note">Simple records. Better decisions.</p>
				</div>
				<div class="home-index" aria-label="Inventory shortcuts">
					<div class="index-topline"><span>Workspace index</span><span>FS / 01</span></div>
					<a class="index-entry" href="/products">
						<span class="index-number">01</span>
						<span><span class="index-entry-title">Products</span><span class="index-entry-meta">Items, prices and available stock</span></span>
						<span class="index-arrow" aria-hidden="true">&rarr;</span>
					</a>
					<a class="index-entry" href="/categories">
						<span class="index-number">02</span>
						<span><span class="index-entry-title">Categories</span><span class="index-entry-meta">The groups behind your catalogue</span></span>
						<span class="index-arrow" aria-hidden="true">&rarr;</span>
					</a>
					<a class="index-entry" href="/products/new">
						<span class="index-number">03</span>
						<span><span class="index-entry-title">Add a product</span><span class="index-entry-meta">Put a new item on the shelf</span></span>
						<span class="index-arrow" aria-hidden="true">&rarr;</span>
					</a>
				</div>
			</div>
		</section>
	</main>

	<%- include('footer') %>
</body>
</html>