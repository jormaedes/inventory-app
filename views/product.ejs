	<div class="product-card">
	<div class="product-visual" aria-hidden="true">
		<span class="visual-index">STOCK RECORD / <%= String(prod.id).padStart(3, '0') %></span>
	</div>
	<div class="product-card-body">
		<div class="card-topline"><span class="card-category"><%= prod.category_name %></span><span class="stock-badge <%= prod.qtd_stock <= 5 ? 'stock-badge--low' : '' %>"><%= prod.qtd_stock %> in stock</span></div>
		<h2 class="card-title"><%= prod.name %></h2>
		<div class="card-price-row">
			<div><span class="card-price-label">Unit price</span><div class="card-price">$<%= Number(prod.price).toFixed(2) %></div></div>
		</div>
		<div class="card-actions">
			<a class="card-action" href="/products/<%= prod.id %>/edit">Edit details</a>
			<a class="card-action card-action--danger" href="/products/<%= prod.id %>/delete">Delete</a>
		</div>
	</div>
</div>